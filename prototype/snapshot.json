            },
            "notes": {
              "type": "str",
              "value": "no onion"
            }
          }
        },
        {
          "label": "cartitemSerializer.create() computed a new value",
          "description": "price never came from the client. It was computed inside create(): product.price (180.00) + meattype.addon_price (40.00) + 80 (doublemeat surcharge) + sum(hotpot ingredient addon prices).",
