          "value": {
            "item.price": {
              "type": "Decimal",
              "value": "315.00"
            },
            "cart.total_price": {
              "type": "Decimal",
              "value": "630.00"
            }
          }
        },
        {
          "label": "HTTP response",
          "description": "The saved row, serialized back out. Slugs render as strings again; price is now present.",
